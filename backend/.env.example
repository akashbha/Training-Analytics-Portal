# PostgreSQL 16 Database Connection String
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/training_portal

# JWT Security
SECRET_KEY=viva-mentor-super-secret-jwt-key-2026-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Configuration
PROJECT_NAME="Training Analytics Portal"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
