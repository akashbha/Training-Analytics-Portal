# ==========================================
# Training Analytics Portal - Backend Environment
# ==========================================

# Deployment environment: development | production
# In production, startup fails if SECRET_KEY is left at the default insecure value.
ENVIRONMENT=development

# Database connection string
# Local SQLite (default quick-start):
DATABASE_URL=sqlite:///./training_portal.db
# PostgreSQL alternative:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/training_portal

# JWT Security (replace with a long random string before production use)
SECRET_KEY=change-this-development-secret-key-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application CORS & Service Integration
PROJECT_NAME="Training Analytics Portal"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# ML Risk Prediction Microservice
ML_SERVICE_URL=http://127.0.0.1:8001
# Optional override path used by ml_service/main.py (defaults to backend/app/ml/risk_model.joblib)
# ML_MODEL_PATH=app/ml/risk_model.joblib
